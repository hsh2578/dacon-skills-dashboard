# === 민감한 파일 (절대 커밋 금지) ===
.env
.env.*
!.env.example
*.env.local
API키.txt
한국투자증권 Api.txt

# API 토큰/자격증명 캐시 — data/ 아래지만 데이터가 아니다.
# fetch_matrix_kis.py가 KIS 액세스 토큰(24h 유효)을 여기 저장한다.
# 이 저장소는 public이므로 절대 커밋되면 안 된다.
data/.cache/
*_token.json
*token.json

# === 캐시/빌드 ===
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
node_modules/
dist/
build/
.next/
.turbo/

# === OS/에디터 ===
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# === 로그/임시 ===
*.log
*.tmp
.gstack/

# 2026-11-24 v6 — 로컬 전용 (사이트가 쓰지 않거나 공개하면 안 되는 것)
# (gitignore 는 줄 중간의 # 을 주석으로 보지 않는다 — 주석은 반드시 별도 줄)
# 뉴스 본문·텔레그램 채널 메시지 원문 — 공개 금지
data/research/
# FnGuide 추정치 스크래핑 원본
data/consensus/
# DART 분기 원천 (2,700 파일) — 사이트는 파생본만 씀
data/financials_q/
# AI 단계 중간 파일
data/screens/_*
